# ---------- 敏感与大文件（私钥/证书） ----------
certs/*.pem
certs/*.key
certs/*.crt

# ---------- 本地模型缓存与音频 ----------
model/
*.raw
*.wav
*.fifo
*.log
*.pid
*.state

# ---------- Python / 工具 ----------
__pycache__/
*.pyc
.DS_Store

